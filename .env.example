# ==============================================================================
# PADAVO B2B SAAS — PRODUCTION CLOUD CONFIGURATION
# ==============================================================================
PORT=5500
NODE_ENV=production
SESSION_SECRET=padavo_super_secret_cryptographic_key_change_in_prod
APP_URL=http://localhost:5500
MAX_UPLOAD_SIZE_MB=15

# ==============================================================================
# 1. DATABASE CONFIGURATION (POSTGRESQL / SUPABASE WITH ROW LEVEL SECURITY)
# ==============================================================================
# Leave commented to use high-speed native SQLite WAL mode on disk,
# or set DATABASE_URL for AWS RDS / Supabase / Neon multi-tenant clustering:
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ==============================================================================
# 2. CLOUDFLARE R2 / AWS S3 OBJECT STORAGE (ZERO EGRESS MEDIA CDN)
# ==============================================================================
# Leave commented to use high-performance local /uploads streaming,
# or set R2/S3 credentials to stream floor photos directly to global CDN:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET=padavo-production-media
# R2_PUBLIC_DOMAIN=https://media.padavo.io

# ==============================================================================
# 3. META WHATSAPP BUSINESS CLOUD API (WABA)
# ==============================================================================
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_permanent_system_user_token
META_WA_VERIFY_TOKEN=padavo_meta_webhook_secret_2026

# ==============================================================================
# 4. SMS OTP GATEWAY (MSG91 / TWILIO FOR INDIAN DLT COMPLIANCE)
# ==============================================================================
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=PADAVO
# MSG91_DLT_TE_ID=your_dlt_template_id
