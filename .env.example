WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=104829104928102
WHATSAPP_VERIFY_TOKEN=padavo_meta_webhook_secret_2026
META_WA_VERIFY_TOKEN=padavo_meta_webhook_secret_2026

# Distributed Edge Database (Optional for Vercel Serverless / Multi-region)
